{
	"manifest_version": 3,
	"name": "Codeforce darkmode",
	"version": "1.0.0",
	"description": "A clean, fully offline dark mode for Codeforces.",
	"homepage_url": "https://github.com/Ravish-Vishwakarma",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "Codeforce darkmode",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://codeforces.com/*", "http://codeforces.com/*"],
			"css": ["theme.css", "code.css"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["imgs/*"],
			"matches": ["https://codeforces.com/*", "http://codeforces.com/*"]
		}
	]
}
